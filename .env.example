# =============================================================================
# cima — environment variables (.env.example)
#
# Every variable the binary reads, with defaults. Copy to `.env` and
# uncomment what you change. docker compose picks it up automatically (an
# `.env` beside docker-compose.yml is loaded, and the cima service also
# forwards HF_TOKEN and CIMA_KEEP_ALIVE); for plain shells,
# `set -a; . ./.env; set +a`.
#
# Two tiers: the public settings below the first divider are a stable
# contract; the diagnostics under "developer diagnostics" are unstable
# escape hatches whose names and behavior may change between versions.
# See docs/configuration.md for the authoritative reference.
# =============================================================================

# ---- server / network -------------------------------------------------------

# Interface the API server binds (cima serve). Default: 127.0.0.1.
# Containers set 0.0.0.0 (the image already does).
#CIMA_HOST=0.0.0.0

# API port. Default: 11435 (ollama parity plus one: both run side by side).
#CIMA_PORT=11435

# Ollama version string reported by GET /api/version (bare X.Y.Z). cima
# advertises compatibility with this Ollama release so stock Ollama clients
# feature-gate correctly; the response also carries an `engine` field with
# cima's own version. Override only if a specific client needs a different
# minimum. Default: a recent stable Ollama semver.
#CIMA_OLLAMA_VERSION=0.6.0

# ---- model store ------------------------------------------------------------

# Root of the local weight store. Default: ./models (relative to CWD).
# Set to a mounted volume when binary and data live apart; the image uses
# /data/models.
#CIMA_MODELS_DIR=/data/models

# Comma-separated ORG/REPO[:TAG] to pull at startup. The server binds
# immediately (so /api/ready is pollable) but reports ready:false until
# every listed model is on disk — the container healthcheck hits /api/ready,
# so dependents using `condition: service_healthy` wait for the pulls.
# Failures are retried with backoff, then surfaced as ready:false + error
# (never a hang or crash). Already-present models are skipped, so a restart
# with a warm volume is fast. Needs HF_TOKEN for gated/private repos.
#CIMA_PULL_AT_STARTUP=Qwen/Qwen2.5-0.5B-Instruct-GGUF:q8_0,google/gemma-4-e4b-it

# ---- model residency --------------------------------------------------------

# How long an idle model stays resident after a request; every served
# request resets the clock. Accepts seconds (600), suffixed durations
# (90s, 10m, 2h), 0 (release immediately after each request), or
# -1 / forever (never evict). A per-request `keep_alive` field overrides
# this per call. Default: 5m.
#CIMA_KEEP_ALIVE=5m

# ---- concurrency ------------------------------------------------------------

# Maximum queued + running requests. At the cap, new requests get HTTP 429
# instead of waiting (fast failure over invisible latency). Default: unset
# (unbounded).
#CIMA_MAX_QUEUE=32

# ---- GPU / engine -----------------------------------------------------------

# CUDA device ordinal to run on. Default: 0.
#CIMA_GPU=0

# Cap the KV-cache context length (positions). KV bytes scale linearly with
# this, so a lower cap is the lever that fits big quantized models on small
# cards (e.g. a 7B Q4_K_M on 6 GB wants CIMA_MAX_SEQ=4096).
# Default: min(model context, engine max).
#CIMA_MAX_SEQ=4096

# ---- Hugging Face Hub -------------------------------------------------------

# Access token for gated/private repositories (cima pull, cima vet
# --preflight). Note the Hub also returns HTTP 401 for repos that do not
# exist when the request is unauthenticated.
#HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- logging / observability ------------------------------------------------

# Terminal verbosity on stderr. Unset: WARN/ERROR only (INFO and METRIC
# always live in the shared-memory ring — read with `cima logs`).
#   info  -> also print INFO/METRIC on stderr
#   debug -> everything, including DEBUG
#CIMA_LOG=info

# Log line format on stderr. text (default) is human-readable; json emits
# one JSON object per line (ts, level, file, line, msg) for collectors.
#CIMA_LOG_FORMAT=json

# Suppress ALL stderr logging (the ring is still written). Used by the test
# suite; useful for cron jobs.
#CIMA_LOG_SILENT=1

# Path of the lock-free shared-memory log ring.
# Default: /dev/shm/cima-log.{uid}.
#CIMA_SHM=/dev/shm/cima-log.0

# =============================================================================
# developer diagnostics — UNSTABLE. Each disables one performance path or
# dumps internals for bisecting a problem without a rebuild. All unset in
# normal operation.
# =============================================================================

# ---- performance-path kill switches -----------------------------------------

# Disable CUDA-graph capture of the decode step (costs throughput and p99
# stability; isolates graph-related issues). Default: unset (graphs on).
#CIMA_NO_GRAPH=1

# Disable the device-resident token pipeline (host roundtrip per token
# instead of on-device argmax/top-k chaining). Default: unset (pipeline on).
#CIMA_NO_PIPELINE=1

# Disable incremental prefill (recompute the whole prompt each turn instead
# of reusing the KV prefix). Default: unset (incremental on).
#CIMA_NO_INCR=1

# Prefill GEMM backend. Default: native k_gemm_f16 kernel, which is
# bit-reproducible (same greedy request -> identical output every run).
# Opt into cuBLAS tensor-core prefill for speed, accepting that its kernel
# selection is NOT run-to-run deterministic on this hardware.
#CIMA_CUBLAS=1
# Force the native kernel even if CIMA_CUBLAS is set (wins over it):
#CIMA_NO_CUBLAS=1

# Page-lock weight mmaps for zero-copy DMA. Opt-in: only wins on native
# Linux with a warm page cache, ample RAM, and a raised `ulimit -l`.
# Default: unset (pageable).
#CIMA_PIN=1

# ---- audits / traces --------------------------------------------------------

# Audit the incremental-prefill token chain (verifies the reused KV prefix
# matches the recomputed one). Default: unset.
#CIMA_INCR_CHECK=1

# Trace VRAM allocation/free events to stderr. Default: unset.
#CIMA_VRAM_TRACE=1

# Prefix-matched families: any variable beginning CIMA_TRACE_ or
# CIMA_DUMP_ enables the correspondingly named tensor trace/dump for
# offline diffing against a reference. Concrete keys the code reads:
#CIMA_DUMP_SOFT=/path/to/prefix   # gemma4 audio: projected soft tokens
#CIMA_DUMP_RENDER=1               # chat-template render output

# ---- gemma4-specific ---------------------------------------------------------

# Verbose gemma4 build/decode diagnostics. Default: unset.
#CIMA_G4_DEBUG=1

# Log the chat-template control markers gemma4 emits. Default: unset.
#CIMA_G4_MARKERS=1

# Override the rotary-embedding span. CIMA_G4_FULL_ROTARY=0 disables the
# engine's full-rotary override and honors config.json instead.
# Default: unset (engine override active).
#CIMA_G4_FULL_ROTARY=0
